# Managed by Ansible (roles/server). Edits on the host will be overwritten.
#
# This is the resolver for the host itself. It is no longer what filters ads
# for a device away from home - the tailnet's global nameserver does that, and
# it overrides whatever the exit node would otherwise inherit from here.
#
# Pi-hole runs as a pod on this same host, so resolution depends on k3s being
# up. FallbackDNS keeps the machine able to resolve if that ever breaks, at the
# cost of a few queries bypassing the blocklist during an outage.
[Resolve]
DNS={{ resolver_primary }}
{% if resolver_fallback | length > 0 %}
FallbackDNS={{ resolver_fallback }}
{% endif %}
Domains=~.
